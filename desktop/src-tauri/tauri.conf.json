{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quadrants",
  "version": "0.2.0",
  "identifier": "com.quadrants.todo",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "",
    "frontendDist": "https://quadrants.ch"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Quadrants",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "contentProtected": false,
        "skipTaskbar": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "tabbingIdentifier": "quadrants",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Four-quadrant task management",
    "longDescription": "Quadrants is a task management app that helps you organize tasks using the Eisenhower Matrix - a four-quadrant system based on urgency and importance.",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "notification": {
      "enabled": true
    },
    "global-shortcut": {}
  }
}
